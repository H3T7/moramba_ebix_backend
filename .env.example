# ── Database ─────────────────────────────────────────────────────────
# This is the connection string Node uses to talk to Postgres.
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
# For local development (the Postgres you installed on your own machine):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moramba_dev"

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────
# Used to sign and verify JWTs (JSON Web Tokens). This MUST be a long,
# random, secret string in real life — never commit a real one to git.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-this-before-you-ever-deploy-anywhere"
JWT_EXPIRES_IN="7d"

# ── CORS ─────────────────────────────────────────────────────────────
# The URL your Moramba frontend runs on (Vite's default dev server port).
CORS_ORIGIN="http://localhost:5173"

# ── Document uploads ─────────────────────────────────────────────────
# Uploaded document files are stored on this machine's disk, under
#   <UPLOAD_DIR>/<companyId>/<random-name>.<ext>
# A relative path is resolved from the folder you start the server in
# (the backend project root). Back this folder up along with the database
# — the database only stores each file's NAME, not the file itself.
UPLOAD_DIR="uploads"
# Largest single file accepted, in megabytes.
MAX_UPLOAD_MB=10
